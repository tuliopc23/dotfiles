# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set ZSH_THEME to empty because we use Oh My Posh
ZSH_THEME=""

# Which plugins would you like to load?
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# User configuration

# Oh My Posh (Direct Load to ensure prompt definition)
if command -v oh-my-posh >/dev/null; then
  eval "$(oh-my-posh init zsh --config ~/.mytheme.omp.json)"
fi

# >>> forge initialize >>>
# !! Contents within this block are managed by 'forge zsh setup' !!
# !! Do not edit manually - changes will be overwritten !!

# Add required zsh plugins if not already present
if [[ ! " ${plugins[@]} " =~ " zsh-autosuggestions " ]]; then
    plugins+=(zsh-autosuggestions)
fi
if [[ ! " ${plugins[@]} " =~ " zsh-syntax-highlighting " ]]; then
    plugins+=(zsh-syntax-highlighting)
fi

# Prefer the known-good local Forge binary when vite-plus shims are present.
FORGE_BIN=""
if [[ -x "$HOME/.local/bin/forge" ]]; then
    FORGE_BIN="$HOME/.local/bin/forge"
elif command -v forge >/dev/null 2>&1 && forge --help >/dev/null 2>&1; then
    FORGE_BIN="$(command -v forge)"
fi

# Load forge shell plugin (commands, completions, keybindings) if not already loaded
if [[ -n "$FORGE_BIN" && -z "$_FORGE_PLUGIN_LOADED" ]]; then
    eval "$("$FORGE_BIN" zsh plugin)"
fi

# Load forge shell theme (prompt with AI context) if not already loaded
if [[ -n "$FORGE_BIN" && -z "$_FORGE_THEME_LOADED" ]]; then
    eval "$("$FORGE_BIN" zsh theme)"
fi
