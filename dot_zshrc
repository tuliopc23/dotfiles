# Prevent disk bloat by routing global installs through vite-plus.
npm() {
  if [[ " $* " == *" -g "* || " $* " == *" --global "* ]]; then
    echo "🚫 Blocked: Global npm installs are disabled to prevent disk bloat."
    echo "👉 Please use: vp add -g <package>"
    return 1
  fi
  command npm "$@"
}

pnpm() {
  if [[ " $* " == *" -g "* || " $* " == *" --global "* ]]; then
    echo "🚫 Blocked: Global pnpm installs are disabled to prevent disk bloat."
    echo "👉 Please use: vp add -g <package>"
    return 1
  fi
  command pnpm "$@"
}
